+  // Edge health ping
+  useEffect(() => {
+    const pingHealth = async () => {
+      try {
+        const start = Date.now();
+        const res = await fetch(`${import.meta.env.BASE_URL}api/health`);
+        if (res.ok) {
+          const ms = Date.now() - start;
+          setEdgeHealth(ms);
+        } else {
+          setEdgeHealth('OFFLINE');
+        }
+      } catch (e) {
+        setEdgeHealth('OFFLINE');
+      }
+    };
